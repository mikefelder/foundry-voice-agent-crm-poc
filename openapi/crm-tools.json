              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "After"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field",
          "label"
        ],
        "title": "FieldChange"
      },
