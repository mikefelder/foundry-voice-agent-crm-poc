{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "toolApiKey": {
      "value": "${TOOL_API_KEY}"
    },
    "crmProvider": {
      "value": "${CRM_PROVIDER=fake}"
    },
    "sfClientId": {
      "value": "${SF_CLIENT_ID=}"
    },
    "sfUsername": {
      "value": "${SF_USERNAME=}"
    },
    "sfPrivateKeyBase64": {
      "value": "${SF_PRIVATE_KEY_BASE64=}"
    },
    "containerImage": {
      "value": "${CONTAINER_IMAGE=mcr.microsoft.com/k8se/quickstart:latest}"
    }
  }
}
