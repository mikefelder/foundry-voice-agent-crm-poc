# Copy to .env and fill in. .env is gitignored; never commit real values.

# ---- Provider selection ----------------------------------------------------
# 'fake'       offline, recorded responses. Use for tests and prompt iteration.
# 'salesforce' live dev org. Use for demos and integration runs.
CRM_PROVIDER=fake

# ---- Salesforce ------------------------------------------------------------
SF_LOGIN_URL=https://login.salesforce.com
# Pin after checking <instance>/services/data
SF_API_VERSION=v62.0

# JWT bearer flow (deployed, and local once the Connected App exists)
SF_CLIENT_ID=
SF_USERNAME=
SF_PRIVATE_KEY_PATH=.secrets/server.key
# Alternative to the path, for Key Vault injection in Container Apps:
# SF_PRIVATE_KEY=

# sf CLI flow (fast local loop before the Connected App is set up)
SF_ORG_ALIAS=devorg

# ---- Foundry project -------------------------------------------------------
PROJECT_ENDPOINT=
PROJECT_NAME=
MODEL_DEPLOYMENT_NAME=gpt-realtime

# ---- Voice Live ------------------------------------------------------------
VOICELIVE_ENDPOINT=
# Agent mode and model mode use different versions. Pin against the installed
# azure-ai-voicelive build rather than copying from documentation.
VOICELIVE_API_VERSION=
VOICE_NAME=en-US-Ava:DragonHDLatestNeural

# ---- Agent -----------------------------------------------------------------
AGENT_NAME=crm-sales-companion
# Optional: pin a version for controlled rollout
AGENT_VERSION=
# Optional: resume a prior conversation
CONVERSATION_ID=

# ---- Tool API --------------------------------------------------------------
TOOL_API_BASE_URL=
TOOL_API_KEY=

# ---- Demo data -------------------------------------------------------------
# Names live here, not in source, so the repo carries no real identities and the
# seed script works against any org.
DEMO_ACCOUNT_NAME=Contoso Building Supply
DEMO_OPPORTUNITY_NAME=Northgate Commons Phase 2
# Full name of an active, Chatter-capable user to @mention in the demo.
# Leave blank and the seed script will suggest valid candidates from the org.
DEMO_MENTION_NAME=
